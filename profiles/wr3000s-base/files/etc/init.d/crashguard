#!/bin/sh /etc/rc.common
# crashguard (see /usr/sbin/crashguard). DRAFT v2 2026-09-26.
# START=09: before S10boot, which mounts pstore (/etc/init.d/boot:43) and then loads
# /etc/modules.d (boot:50: mt7915e, safexcel, nft...), the likeliest boot-loop crash site after the
# kernel itself. procd runs S* scripts one at a time with no timeout (procd rcS.c:163-165, :204),
# so 'collect' is bounded: it touches only pstore, the overlay and /dev/kmsg, and it never reads
# /etc/crashguard.conf (a broken conf cannot stop the release the U-Boot limiter depends on).
# The alerting runs as a procd instance, waits for logd itself, does not respawn, and exits once
# nothing is left (it stays up when a heartbeat is configured). Its stdout and stderr go to the log.
START=09
USE_PROCD=1

boot() {
	/usr/sbin/crashguard collect
	start "$@"
}

start_service() {
	procd_open_instance watch
	procd_set_param command /usr/sbin/crashguard watch
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
