#!/bin/sh
# Estate baseline, applied once at first boot.
#   UTC everywhere (whole estate is UTC since 2026-07-29)
#   dropbear demoted to :2222, key-only  (OpenSSH owns :22)
# Remote syslog is NOT set here. The collector's address is estate-specific, so the private
# overlay sets it, in its own uci-defaults script.
# Roles (bridge AP / primary router) are applied AFTER flashing, not here.
uci -q set system.@system[0].timezone='UTC'
uci -q set system.@system[0].zonename='UTC'
uci -q commit system

uci -q set dropbear.@dropbear[0].Port='2222'
uci -q set dropbear.@dropbear[0].PasswordAuth='off'
uci -q set dropbear.@dropbear[0].RootPasswordAuth='off'
uci -q commit dropbear

# LuCI/uhttpd authenticates against the SAME root password as the shell account, so with
# SSH password auth off it is the remaining password surface. It is kept off the WAN/transit
# side by the FIREWALL (fw4 'wan' zone input REJECT), NOT by binding to a fixed address:
# an earlier draft pinned listen_http to 192.168.1.1, which would have silently stranded
# LuCI the moment the LAN was renumbered off the OpenWrt default. Whoever gives this box a
# transit/WAN interface must put it in a zone with input REJECT.
/etc/init.d/sshd enable 2>/dev/null || true
exit 0
