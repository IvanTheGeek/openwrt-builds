# Fuller tools beside BusyBox (owner, 2026-09-26): targeted packages, not the whole of coreutils,
# because some OpenWrt scripts rely on BusyBox-only options of core commands (e.g. date -D). shadow-utils with
# shadow-all OFF: only chpasswd, not shadow's login/su/passwd. The procps-ng applets need the parent selected.
# NOT procps-ng-ps (owner, 2026-09-26): it takes over /bin/ps, and procps 'ps w' over ssh lists NO processes
# (measured), silently breaking the OpenWrt 'ps w | grep <daemon>' check. BusyBox ps stays.
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_shadow-utils=y
# CONFIG_shadow-all is not set
CONFIG_PACKAGE_shadow-chpasswd=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_sed=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_procps-ng=y
